<resources>

    <!-- Contador de notificações: mostrar até 999 antes de resumir -->
    <integer name="status_bar_notification_info_maxnum">999</integer>

    <!-- Divisor de corrente de carregamento: 1000 para converter mA -->
    <integer name="config_currentInfoDivider" translatable="false">1000</integer>

    <!-- On-The-Go: tempos de timeout do diálogo -->
    <integer name="quick_settings_onthego_dialog_short_timeout">3000</integer>
    <integer name="quick_settings_onthego_dialog_long_timeout">6000</integer>

    <!-- IMPORTANTE: Desativar Smart Pixels sobre o UDFPS.
         Como ativamos Smart Pixels no Framework, se não desativarmos aqui,
         a digital vai falhar porque os pixels na área do sensor estarão apagados. -->
    <bool name="config_disableSmartPixelsOnUDFPS">true</bool>

    <!-- Sensor de temperatura da CPU para o SM6225 -->
    <string name="config_cpuTempSensor" translatable="false">/sys/class/thermal/thermal_zone0/temp</string>

    <!-- Divisor de temperatura: Xiaomi reporta em miligraus (ex: 40000 = 40°C), então dividimos por 1000 -->
    <integer name="config_cpuTempDivider" translatable="false">1000</integer>

    <!-- CPUs para exibir no serviço de Info da CPU (SM6225 tem 8 núcleos) -->
    <string name="config_displayCpus" translatable="false">0-7</string>

    <!-- Caminho do nó de FPS para o Sapphire -->
    <string name="config_fpsInfoSysNode" translatable="false">/sys/class/drm/sde-crtc-0/measured_fps</string>

    <!-- O Note 13 4G não suporta 5G/VoNR nativamente, então definimos como false para evitar confusão no menu -->
    <bool name="config_supportsVONR">false</bool>

    <!-- Atualizar info de bateria a cada segundo durante o carregamento rápido -->
    <bool name="config_alternateFastchargeInfoUpdate">true</bool>

</resources>
